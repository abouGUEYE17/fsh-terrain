{
  "name": "fsh-terrain",
  "version": "1.0.0",
  "private": true,
  "description": "FSH Terrain – collecte terrain, séances de sensibilisation et rapports de la Fédération Sénégalaise des Habitants",
  "author": "Fédération Sénégalaise des Habitants",
  "license": "UNLICENSED",
  "main": "desktop/main.js",
  "scripts": {
    "desktop": "electron .",
    "build:windows": "electron-builder --win --publish never",
    "build:mac": "electron-builder --mac --publish never",
    "android:add": "cap add android && bash scripts/prepare-android.sh && cap sync android"
  },
  "devDependencies": {
    "@capacitor/android": "7.6.5",
    "@capacitor/cli": "7.6.5",
    "@capacitor/core": "7.6.5",
    "electron": "42.11.13",
    "electron-builder": "26.15.0"
  },
  "build": {
    "appId": "sn.fsh.terrain",
    "productName": "FSH Terrain",
    "directories": {
      "output": "dist-desktop"
    },
    "files": [
      "desktop/**",
      "web/**",
      "build/icon.png"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "FSH Terrain",
      "artifactName": "FSH-Terrain-Installation-${version}.exe"
    },
    "portable": {
      "artifactName": "FSH-Terrain-Portable-${version}.exe"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.productivity",
      "identity": "-"
    },
    "dmg": {
      "artifactName": "FSH-Terrain-${version}-Mac.dmg",
      "title": "FSH Terrain"
    }
  }
}
